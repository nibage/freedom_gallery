# Only the app and the bundled demo gallery are publishable by default.
*
!.gitignore
!README.md
!__gallery/
__gallery/*
!__gallery/index.html
!demo-gallery/
!demo-gallery/**/
!demo-gallery/**/*.svg
!demo-gallery/README.md
!demo-gallery/__gallery/data/favorites.txt
!demo-gallery/__gallery/data/tags.tsv
!demo-gallery/__gallery/data/albums/*.txt
# Any generated demo thumbnails / media indexes remain ignored.
!demo-gallery/__gallery/data/tag-catalog.txt
